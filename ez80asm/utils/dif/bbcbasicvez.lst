       8E          
0001C8             0678   			VDU	23
                       M1 Args: VAL=23 
0001C8 3E 17       0001M1         LD      A, VAL
0001CA CD 97 05    0002M1         CALL    OSWRCH
0001CD             0679   			VDU	0
                       M1 Args: VAL=0 
0001CD 3E 00       0001M1         LD      A, VAL
0001CF CD 97 05    0002M1         CALL    OSWRCH
0001D2             0680   			VDU	vdp_scrchar
                       M1 Args: VAL=vdp_scrchar 
