0007F9 23          1834   			INC	HL			; Skip the length byte
0007FA 5E          1835   			LD	E, (HL)			; Get the line number
0007FB 23          1836   			INC	HL
0007FC 56          1837   			LD	D, (HL)
0007FD 23          1838   			INC	HL
