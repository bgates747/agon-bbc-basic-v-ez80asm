00519B             14720   end_binary: ;  for 05_assemble.py to know where to truncate the binary file
00519B             14721                   ALIGN 256
005200             14722   FLAGS:          DS	1
005201             14723   OSWRCHPT:       DS	2
005203             14724   OSWRCHCH:       DS	1
005204             14725   OSWRCHFH:       DS	1
005205             14726   KEYDOWN:        DS	1
005206             14727   KEYASCII:       DS	1
005207             14728   KEYCOUNT:       DS	1
005208             14729   SCRAP:          DS	31
005227             14730   ;
005227             14731                   ALIGN 256
005300             14732   ;
005300             14733   ;RAM MODULE FOR BBC BASIC INTERPRETER
005300             14734   ;FOR USE WITH VERSION 5.0 OF BBC BASIC
005300             14735   ;(C) COPYRIGHT R.T.RUSSELL 1981-2024
005300             14736   ;
005300             14737   ;                XDEF	ACCS
005300             14738   ;                XDEF	BUFFER
005300             14739   ;                XDEF	ONERSP
005300             14740   ;                XDEF	LIBASE
005300             14741   ;                XDEF	PAGE_
005300             14742   ;                XDEF	LOMEM
005300             14743   ;                XDEF	FREE
005300             14744   ;                XDEF	HIMEM
005300             14745   ;                XDEF	RANDOM
005300             14746   ;                XDEF	COUNT
005300             14747   ;                XDEF	WIDTH
005300             14748   ;                XDEF	ERL
005300             14749   ;                XDEF	ERR
005300             14750   ;                XDEF	ERRTRP
005300             14751   ;                XDEF	ERRTXT
005300             14752   ;                XDEF	TRACEN
005300             14753   ;                XDEF	AUTONO
005300             14754   ;                XDEF	INCREM
005300             14755   ;                XDEF	LISTON
005300             14756   ;                XDEF	DATPTR
005300             14757   ;                XDEF	FNPTR
005300             14758   ;                XDEF	PROPTR
005300             14759   ;                XDEF	STAVAR
005300             14760   ;                XDEF	OC
005300             14761   ;                XDEF	PC
005300             14762   ;                XDEF	DYNVAR
005300             14763   ;                XDEF	CURLIN
005300             14764   ;                XDEF	USER
005300             14765   ;
005300             14766   ;n.b. ACCS, BUFFER & STAVAR must be on page boundaries.
005300             14767   ;
005300             14768   ACCS:           DS	256		;STRING ACCUMULATOR
005400             14769   BUFFER:         DS	256		;STRING INPUT BUFFER
005500             14770   
005500             14771   STAVAR:         DS	27*4		;STATIC VARIABLES
00556C             14772   ; OC:             EQU	STAVAR+15*4	;CODE ORIGIN (O%)	; restored from equs.inc
00556C             14773   ; PC:             EQU	STAVAR+16*4	;PROGRAM COUNTER (P%)	; restored from equs.inc
00556C             14774   OC:             EQU	15*4+STAVAR	;CODE ORIGIN (O%)	; restored from equs.inc
00556C             14775   PC:             EQU	16*4+STAVAR	;PROGRAM COUNTER (P%)	; restored from equs.inc
00556C             14776   DYNVAR:         DS	54*2		;DYN. VARIABLE POINTERS
0055D8             14777   FNPTR:          DS	2		;DYN. FUNCTION POINTER
0055DA             14778   PROPTR:         DS	2		;DYN. PROCEDURE POINTER
0055DC             14779   ;
0055DC             14780   PAGE_:          DS	2		;START OF USER PROGRAM
0055DE             14781   LOMEM:          DS	2		;START OF DYN. STORAGE
0055E0             14782   FREE:           DS	2		;FIRST FREE-SPACE BYTE
0055E2             14783   HIMEM:          DS	2		;FIRST BYTE ABOVE STACK
0055E4             14784   LIBASE:         DS	2		;START OF FIRST LIBRARY
0055E6             14785   ;
0055E6             14786   TRACEN:         DS	2		;TRACE FLAG & NUMBER
0055E8             14787   AUTONO:         DS	2		;AUTO FLAG & NUMBER
0055EA             14788   ERRTRP:         DS	2		;ON ERROR STMT POINTER \
0055EC             14789   ONERSP:         DS	2		;ON ERROR LOCAL STKPTR /
0055EE             14790   ERRTXT:         DS	2		;ERROR MESSAGE POINTER
0055F0             14791   DATPTR:         DS	2		;DATA POINTER
0055F2             14792   ERL:            DS	2		;LINE NO OF LAST ERROR
0055F4             14793   CURLIN:         DS	2		;POINTER TO CURRENT LINE
0055F6             14794   RANDOM:         DS	5		;RANDOM NUMBER
0055FB             14795   COUNT:          DS	1		;PRINT POSITION
0055FC             14796   WIDTH:          DS	1		;PRINT WIDTH
0055FD             14797   ERR:            DS	1		;ERROR NUMBER
0055FE             14798   LISTON:         DS	1		;LISTO & OPT FLAG
0055FF             14799   INCREM:         DS	1		;AUTO INCREMENT
005600             14800   VDU_BUFFER:		EQU	ACCS		; Storage for VDU commands ; originally in equs.inc
005600             14801   ;
005600             14802   USER:           ; END
005600             14803   ; --- End data.asm ---
